# EditorConfig: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Java 源码与 Maven POM
[*.{java,xml}]
indent_size = 4

# 配置与数据文件
[*.{yml,yaml,json,properties,toml}]
indent_size = 2

# 文档允许保留行尾空格
[*.md]
trim_trailing_whitespace = false
